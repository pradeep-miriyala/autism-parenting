# Little Steps: copy to .env.local and fill in. Nothing here is committed.

# The database for the anonymous counts and the shared names (see README, "Dashboard and privacy").
MONGODB_URI=
# Optional: the database name. Defaults to the one the numbers already live in.
MONGODB_DB=pradeep-site

# The admin dashboard at /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD_PLAIN=
NEXTAUTH_SECRET=
# The address of this site: http://localhost:3000 locally, the real address in production.
NEXTAUTH_URL=http://localhost:3000

# The address of this site, for links and previews (optional; defaults to localhost).
NEXT_PUBLIC_SITE_URL=
# Where the "by Pradeep Miriyala" links go.
NEXT_PUBLIC_PORTFOLIO_URL=https://pradeep.miriyala.in
